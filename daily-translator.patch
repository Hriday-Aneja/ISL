@@ -0,0 +1,257 @@
+import { useMemo, useState } from 'react';
+import { Pencil, Plus, Search, X, Copy } from 'lucide-react';
+import {
+  SCENARIOS,
+  SCENARIO_CARDS,
+  getScenario,
+  type ScenarioId,
+} from '../../data/dailyScenarios';
+import {
+  cardKey,
+  customCardsFor,
+  isFavouriteCard,
+  type CustomCard,
+  type DailyState,
+  type MessageSource,
+} from '../../lib/dailyStore';
+import { PhraseCard } from './PhraseCard';
+import { SuggestionsPanel } from './SuggestionsPanel';
+
+interface CardsTabProps {
+  scenario: ScenarioId;
+  state: DailyState;
+  aiAvailable: boolean | null;
+  recentTexts: string[];
+  /** Submitted description for a custom situation. */
+  description: string;
+  descriptionToken: number;
+  onSubmitDescription: (text: string) => void;
+  onSend: (text: string, source: MessageSource) => void;
+  onToggleFavourite: (text: string) => void;
+  onNewCard: (initialText?: string) => void;
+  onEditCard: (card: CustomCard) => void;
+  onCustomise: (text: string) => void;
+}
+
+interface Result {
+  text: string;
+  source: MessageSource;
+  eyebrow?: string;
+  mine?: CustomCard;
+}
+
+// Every preset card across all scenarios, de-duplicated by text, for search.
+const ALL_PRESETS: Array<{ text: string; scenarioLabel: string }> = (() => {
+  const seen = new Set<string>();
+  const out: Array<{ text: string; scenarioLabel: string }> = [];
+  for (const s of SCENARIOS) {
+    if (s.id === 'custom') continue;
+    for (const card of SCENARIO_CARDS[s.id as Exclude<ScenarioId, 'custom'>]) {
+      const key = cardKey(card.text);
+      if (seen.has(key)) continue;
+      seen.add(key);
+      out.push({ text: card.text, scenarioLabel: s.label });
+    }
+  }
+  return out;
+})();
+
+export function CardsTab({
+  scenario,
+  state,
+  aiAvailable,
+  recentTexts,
+  description,
+  descriptionToken,
+  onSubmitDescription,
+  onSend,
+  onToggleFavourite,
+  onNewCard,
+  onEditCard,
+  onCustomise,
+}: CardsTabProps) {
+  const [query, setQuery] = useState('');
+  const [draftDescription, setDraftDescription] = useState(description);
+  const info = getScenario(scenario);
+  const isCustom = scenario === 'custom';
+
+  const presets = useMemo(
+    () => (isCustom ? [] : SCENARIO_CARDS[scenario as Exclude<ScenarioId, 'custom'>]),
+    [scenario, isCustom]
+  );
+  const mine = customCardsFor(state, scenario);
+
+  const existingTexts = useMemo(
+    () => [...presets.map((c) => c.text), ...mine.map((c) => c.text)],
+    [presets, mine]
+  );
+
+  const q = query.trim().toLowerCase();
+  const results: Result[] = useMemo(() => {
+    if (!q) return [];
+    const out: Result[] = [];
+    const seen = new Set<string>();
+    const push = (r: Result) => {
+      const key = cardKey(r.text);
+      if (seen.has(key)) return;
+      seen.add(key);
+      out.push(r);
+    };
+    state.customCards
+      .filter((c) => c.text.toLowerCase().includes(q))
+      .forEach((c) => push({ text: c.text, source: 'custom-card', eyebrow: 'My card', mine: c }));
+    state.favouriteCards
+      .filter((f) => f.text.toLowerCase().includes(q))
+      .forEach((f) => push({ text: f.text, source: 'card', eyebrow: 'Favourite' }));
+    ALL_PRESETS.filter((c) => c.text.toLowerCase().includes(q)).forEach((c) =>
+      push({ text: c.text, source: 'card', eyebrow: c.scenarioLabel })
+    );
+    return out;
+  }, [q, state.customCards, state.favouriteCards]);
+
+  const renderPreset = (text: string, source: MessageSource = 'card', mineCard?: CustomCard, eyebrow?: string) => (
+    <PhraseCard
+      key={`${source}-${cardKey(text)}`}
+      text={text}
+      eyebrow={eyebrow}
+      tone={mineCard ? 'mine' : source === 'suggestion' ? 'suggestion' : 'default'}
+      favourite={isFavouriteCard(state, text)}
+      onSelect={() => onSend(text, source)}
+      onToggleFavourite={() => onToggleFavourite(text)}
+      extra={
+        mineCard
+          ? { label: 'Edit card', icon: <Pencil size={18} />, onClick: () => onEditCard(mineCard) }
+          : { label: 'Save a copy to edit', icon: <Copy size={18} />, onClick: () => onCustomise(text) }
+      }
+    />
+  );
+
+  return (
+    <div className="space-y-6">
+      <div>
+        <label htmlFor="card-search" className="sr-only">
+          Search cards
+        </label>
+        <div className="relative">
+          <Search size={18} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-mist" />
+          <input
+            id="card-search"
+            type="search"
+            value={query}
+            onChange={(event) => setQuery(event.target.value)}
+            placeholder="Search all cards"
+            autoComplete="off"
+            className="min-h-[52px] w-full rounded-md border-2 border-white/15 bg-night-card pl-11 pr-12 text-lg text-cream outline-none focus-visible:border-signal"
+          />
+          {query && (
+            <button
+              type="button"
+              onClick={() => setQuery('')}
+              aria-label="Clear search"
+              className="absolute right-1.5 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-sm text-mist hover:text-cream"
+            >
+              <X size={18} />
+            </button>
+          )}
+        </div>
+      </div>
+
+      {q ? (
+        <section aria-label="Search results" className="space-y-2">
+          <p role="status" className="text-sm text-mist">
+            {results.length === 0 ? 'No cards match' : `${results.length} card${results.length === 1 ? '' : 's'} found`} “{query.trim()}”
+          </p>
+          {results.map((r) => renderPreset(r.text, r.source, r.mine, r.eyebrow))}
+          {results.length === 0 && (
+            <button type="button" onClick={() => onNewCard(query.trim())} className="btn-secondary min-h-[48px] text-base">
+              <Plus size={18} /> Make a card saying “{query.trim()}”
+            </button>
+          )}
+        </section>
+      ) : (
+        <>
+          {isCustom && (
+            <section aria-labelledby="custom-heading" className="daily-surface rounded-md border-2 border-white/15 bg-night-card p-4">
+              <h3 id="custom-heading" className="font-display text-lg font-semibold text-cream">
+                Describe your situation
+              </h3>
+              <form
+                className="mt-2 space-y-3"
+                onSubmit={(event) => {
+                  event.preventDefault();
+                  const text = draftDescription.trim();
+                  if (text) onSubmitDescription(text);
+                }}
+              >
+                <label htmlFor="custom-description" className="sr-only">
+                  Describe your situation
+                </label>
+                <textarea
+                  id="custom-description"
+                  value={draftDescription}
+                  onChange={(event) => setDraftDescription(event.target.value)}
+                  maxLength={400}
+                  rows={3}
+                  placeholder="e.g. I am at the bank to open an account and need to talk to the manager."
+                  className="w-full rounded-sm border-2 border-white/15 bg-night px-3 py-2.5 text-lg text-cream outline-none focus-visible:border-signal"
+                />
+                <button type="submit" disabled={!draftDescription.trim()} className="btn-primary min-h-[48px] px-5 text-base">
+                  Get cards for this situation
+                </button>
+              </form>
+              {description && (
+                <p className="mt-3 text-sm text-mist">
+                  Showing cards for: <span className="font-medium text-cream">{description}</span>
+                </p>
+              )}
+            </section>
+          )}
+
+          {!isCustom && (
+            <section aria-labelledby="scenario-cards-heading" className="space-y-2">
+              <h3 id="scenario-cards-heading" className="font-display text-lg font-semibold text-cream">
+                {info.label}
+              </h3>
+              <div className="grid gap-2 xl:grid-cols-2">
+                {presets.map((card) => renderPreset(card.text, scenario === 'emergency' ? 'emergency' : 'card'))}
+              </div>
+            </section>
+          )}
+
+          <section aria-labelledby="my-cards-heading" className="space-y-2">
+            <div className="flex items-center justify-between gap-3">
+              <h3 id="my-cards-heading" className="font-display text-lg font-semibold text-cream">
+                My cards
+              </h3>
+              <button type="button" onClick={() => onNewCard()} className="btn-secondary min-h-[48px] px-4 text-base">
+                <Plus size={18} /> New card
+              </button>
+            </div>
+            {mine.length === 0 ? (
+              <p className="rounded-md border-2 border-dashed border-white/15 px-4 py-5 text-base text-mist">
+                You have no cards for this situation yet. Tap <strong>New card</strong> to write your own — it is saved on this device.
+              </p>
+            ) : (
+              <div className="grid gap-2 xl:grid-cols-2">
+                {mine.map((card) => renderPreset(card.text, 'custom-card', card))}
+              </div>
+            )}
+          </section>
+
+          <SuggestionsPanel
+            key={scenario}
+            scenarioId={scenario}
+            scenarioLabel={info.label}
+            description={description}
+            existingTexts={existingTexts}
+            recentTexts={recentTexts}
+            aiAvailable={aiAvailable}
+            autoFetchToken={descriptionToken}
+            needsDescription={isCustom && !description}
+            renderCard={(text) => renderPreset(text, 'suggestion')}
+          />
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/isl-comp-updated/isl-comp/src/components/daily/Composer.tsx b/isl-comp-updated/isl-comp/src/components/daily/Composer.tsx
new file mode 100644
index 0000000..4626e0e
--- /dev/null
+++ b/isl-comp-updated/isl-comp/src/components/daily/Composer.tsx
@@ -0,0 +1,179 @@
+import { useEffect, useRef, useState } from 'react';
+import { AlertTriangle, Mic, Send, Square, X } from 'lucide-react';
+import { useSpeechRecognition } from '../../hooks/useSpeechRecognition';
+import type { MessageSender, MessageSource } from '../../lib/dailyStore';
+
+interface ComposerProps {
+  onSend: (text: string, sender: MessageSender, source: MessageSource) => void;
+}
+
+const MAX_MESSAGE_LENGTH = 500;
+
+/**
+ * Typing + voice in one place. Speech fills the same box you can type in, so
+ * the text can always be corrected before it is sent: nothing recognised is
+ * sent automatically.
+ */
+export function Composer({ onSend }: ComposerProps) {
+  const { state, start, stop, reset, supported } = useSpeechRecognition();
+  const [draft, setDraft] = useState('');
+  const [sender, setSender] = useState<MessageSender>('other');
+  const [fromSpeech, setFromSpeech] = useState(false);
+  const baseRef = useRef('');
+  const listening = state.status === 'listening';
+
+  // While listening, mirror the live transcript (final + still-forming words)
+  // after whatever was already in the box.
+  useEffect(() => {
+    if (!listening) return;
+    const live = [baseRef.current, state.finalTranscript, state.interimTranscript]
+      .filter(Boolean)
+      .join(' ')
+      .replace(/\s+/g, ' ')
+      .trim();
+    setDraft(live.slice(0, MAX_MESSAGE_LENGTH));
+    if (state.finalTranscript || state.interimTranscript) setFromSpeech(true);
+  }, [listening, state.finalTranscript, state.interimTranscript]);
+
+  const toggleMic = () => {
+    if (listening) {
+      stop();
+      return;
+    }
+    baseRef.current = draft.trim();
+    reset();
+    start();
+  };
+
+  const clear = () => {
+    if (listening) stop();
+    setDraft('');
+    setFromSpeech(false);
+    baseRef.current = '';
+    reset();
+  };
+
+  const submit = () => {
+    const text = draft.trim();
+    if (!text) return;
+    if (listening) stop();
+    onSend(text, sender, fromSpeech ? 'speech' : 'typed');
+    clear();
+  };
+
+  const permissionDenied = state.status === 'error' && /denied|not allowed/i.test(state.errorMessage ?? '');
+
+  return (
+    <div className="space-y-2.5 border-t border-white/15 bg-night-card p-3.5">
+      <div role="group" aria-label="Who is sending this message?" className="grid grid-cols-2 gap-2">
+        {([
+          ['other', 'Other person'],
+          ['me', 'Me'],
+        ] as const).map(([value, label]) => (
+          <button
+            key={value}
+            type="button"
+            aria-pressed={sender === value}
+            onClick={() => setSender(value)}
+            className={`min-h-[44px] rounded-sm border-2 text-sm font-bold transition-colors ${
+              sender === value
+                ? value === 'me'
+                  ? 'border-signal bg-signal text-[#06231d]'
+                  : 'border-voice-deep bg-voice text-[#1A1204]'
+                : 'border-white/15 bg-night-card text-mist hover:text-cream'
+            }`}
+          >
+            {label}
+          </button>
+        ))}
+      </div>
+
+      <div>
+        <label htmlFor="composer-draft" className="sr-only">
+          Message to add to the conversation
+        </label>
+        <textarea
+          id="composer-draft"
+          value={draft}
+          readOnly={listening}
+          rows={2}
+          maxLength={MAX_MESSAGE_LENGTH}
+          onChange={(event) => {
+            setDraft(event.target.value);
+            if (!event.target.value.trim()) setFromSpeech(false);
+          }}
+          onKeyDown={(event) => {
+            if (event.key === 'Enter' && !event.shiftKey && !event.nativeEvent.isComposing) {
+              event.preventDefault();
+              submit();
+            }
+          }}
+          placeholder={listening ? 'Listening… speak now' : 'Type here, or tap the microphone and speak'}
+          className={`w-full resize-none rounded-md border-2 bg-night px-3 py-2.5 text-lg text-cream outline-none focus-visible:border-signal ${
+            listening ? 'border-voice-deep' : 'border-white/15'
+          }`}
+        />
+        <p className="mt-1 text-xs text-mist" id="composer-hint">
+          {listening
+            ? 'Words appear as you speak. Tap Stop when finished, then check the text.'
+            : fromSpeech && draft
+              ? 'Check the text and fix any mistakes, then press Send.'
+              : 'Enter to send · Shift+Enter for a new line'}
+        </p>
+      </div>
+
+      <p className="sr-only" role="status" aria-live="polite">
+        {listening ? 'Listening' : ''}
+      </p>
+
+      {!supported && (
+        <p role="alert" className="flex items-start gap-2 rounded-sm border border-voice/50 bg-voice-soft px-3 py-2 text-sm text-cream">
+          <AlertTriangle size={16} className="mt-0.5 shrink-0 text-voice-deep" />
+          Speech recognition is not supported in this browser. Use Chrome or Edge to speak, or type your message above.
+        </p>
+      )}
+
+      {state.status === 'error' && state.errorMessage && (
+        <p role="alert" className="flex items-start gap-2 rounded-sm border border-alert/40 bg-alert/15 px-3 py-2 text-sm text-cream">
+          <AlertTriangle size={16} className="mt-0.5 shrink-0 text-[#ff9a90]" />
+          <span>
+            {state.errorMessage}
+            {permissionDenied && ' Click the lock icon in the address bar, allow the microphone, then tap the microphone button again.'}
+          </span>
+        </p>
+      )}
+
+      <div className="flex items-stretch gap-2">
+        <button
+          type="button"
+          onClick={toggleMic}
+          disabled={!supported}
+          aria-pressed={listening}
+          aria-label={listening ? 'Stop listening' : 'Speak into the microphone'}
+          className={`inline-flex min-h-[52px] flex-1 items-center justify-center gap-2 rounded-sm border-2 text-base font-bold transition-colors disabled:cursor-not-allowed disabled:opacity-40 ${
+            listening
+              ? 'border-[#b83a3a] bg-[#b83a3a] text-white hover:bg-[#9f3030]'
+              : 'border-voice-deep bg-voice text-[#1A1204] hover:bg-voice-deep hover:text-[#1A1204]'
+          }`}
+        >
+          {listening ? <Square size={17} /> : <Mic size={19} />}
+          {listening ? 'Stop' : 'Speak'}
+        </button>
+        <button
+          type="button"
+          onClick={submit}
+          disabled={!draft.trim()}
+          className="btn-primary min-h-[52px] flex-1 px-4 text-base font-bold"
+        >
+          <Send size={18} /> Send
+        </button>
+        {draft && (
+          <button type="button" onClick={clear} aria-label="Clear text" className="icon-btn h-auto min-h-[52px] w-12">
+            <X size={18} />
+          </button>
+        )}
+      </div>
+    </div>
+  );
+}
+
diff --git a/isl-comp-updated/isl-comp/src/components/daily/ConversationPanel.tsx b/isl-comp-updated/isl-comp/src/components/daily/ConversationPanel.tsx
