@@ -0,0 +1,151 @@
+import { useMemo, useState } from 'react';
+import { Info, Maximize2, Square, Video, VideoOff, Volume2 } from 'lucide-react';
+import { getSignById, signsInText, type IslSign } from '../../data/islSigns';
+import type { DailyMessage, MessageSource } from '../../lib/dailyStore';
+import { SignVideo } from './SignVideo';
+
+export const SOURCE_LABEL: Record<MessageSource, string> = {
+  card: 'Card',
+  'custom-card': 'My card',
+  suggestion: 'Suggestion',
+  emergency: 'Emergency',
+  sign: 'ISL sign',
+  typed: 'Typed',
+  speech: 'Speech',
+};
+
+export function formatTime(timestamp: number): string {
+  return new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+}
+
+interface MessageBubbleProps {
+  message: DailyMessage;
+  featured: boolean;
+  largeText: boolean;
+  speaking: boolean;
+  ttsSupported: boolean;
+  onSpeak: () => void;
+  onFocus: () => void;
+  onOpenSign: (sign: IslSign) => void;
+}
+
+export function MessageBubble({
+  message,
+  featured,
+  largeText,
+  speaking,
+  ttsSupported,
+  onSpeak,
+  onFocus,
+  onOpenSign,
+}: MessageBubbleProps) {
+  const me = message.sender === 'me';
+  const [showSigns, setShowSigns] = useState(false);
+
+  const sign = message.signId ? getSignById(message.signId) : undefined;
+  const related = useMemo(
+    () => (message.source === 'sign' ? [] : signsInText(message.text)),
+    [message.source, message.text]
+  );
+
+  const textSize = featured
+    ? largeText
+      ? 'text-4xl'
+      : 'text-3xl'
+    : largeText
+      ? 'text-2xl'
+      : 'text-lg';
+
+  return (
+    <article
+      aria-label={`${me ? 'You' : 'Other person'} at ${formatTime(message.timestamp)}`}
+      className={`flex flex-col ${me ? 'items-end' : 'items-start'}`}
+    >
+      <div
+        className={`daily-surface w-full max-w-[96%] rounded-md border-2 px-4 py-3 ${
+          me ? 'border-signal bg-signal-soft' : 'border-voice bg-voice-soft'
+        } ${featured ? 'shadow-stage' : ''}`}
+      >
+        <div className="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
+          <p className={`text-sm font-bold uppercase tracking-wide ${me ? 'text-signal-deep' : 'text-voice-deep'}`}>
+            {me ? 'You' : 'Other person'}
+          </p>
+          <p className="text-xs text-mist">
+            {SOURCE_LABEL[message.source]} · <time dateTime={new Date(message.timestamp).toISOString()}>{formatTime(message.timestamp)}</time>
+          </p>
+        </div>
+
+        <p className={`mt-1 break-words font-display font-semibold leading-snug text-cream ${textSize}`}>{message.text}</p>
+
+        {message.source === 'sign' && (
+          <div className="mt-3">
+            {sign?.videoSrc ? (
+              <SignVideo src={sign.videoSrc} label={sign.label} autoPlay={featured} className="max-h-72" />
+            ) : (
+              <p role="status" className="flex items-start gap-2 rounded-sm border border-dashed border-ink-soft/50 bg-white/10 px-3 py-2 text-sm text-cream">
+                <VideoOff size={16} className="mt-0.5 shrink-0" />
+                No sign video is available for &ldquo;{message.text}&rdquo; yet &mdash; only its name is shown.
+              </p>
+            )}
+          </div>
+        )}
+
+        <div className="mt-2.5 flex flex-wrap items-center gap-2">
+          {ttsSupported && (
+            <button
+              type="button"
+              onClick={onSpeak}
+              aria-pressed={speaking}
+              aria-label={speaking ? 'Stop speaking this message' : 'Speak this message aloud'}
+              className="inline-flex min-h-[44px] items-center gap-1.5 rounded-sm bg-white/10 px-3 text-sm font-semibold text-cream hover:bg-white/20"
+            >
+              {speaking ? <Square size={15} /> : <Volume2 size={16} />}
+              {speaking ? 'Stop' : 'Speak'}
+            </button>
+          )}
+          <button
+            type="button"
+            onClick={onFocus}
+            className="inline-flex min-h-[44px] items-center gap-1.5 rounded-sm bg-white/10 px-3 text-sm font-semibold text-cream hover:bg-white/20"
+          >
+            <Maximize2 size={15} /> Full screen
+          </button>
+          {related.length > 0 && (
+            <button
+              type="button"
+              onClick={() => setShowSigns((v) => !v)}
+              aria-expanded={showSigns}
+              className="inline-flex min-h-[44px] items-center gap-1.5 rounded-sm bg-white/10 px-3 text-sm font-semibold text-cream hover:bg-white/20"
+            >
+              <Video size={15} /> Signs in this message ({related.length})
+            </button>
+          )}
+        </div>
+
+        {showSigns && related.length > 0 && (
+          <div className="mt-2 rounded-sm border border-white/15 bg-white/10 p-2.5">
+            <div className="flex flex-wrap gap-1.5">
+              {related.map((s) => (
+                <button
+                  key={s.id}
+                  type="button"
+                  onClick={() => onOpenSign(s)}
+                  className="inline-flex min-h-[40px] items-center gap-1.5 rounded-full border-2 border-white/15 bg-night-card px-3 text-sm font-semibold text-cream hover:border-signal"
+                >
+                  {s.label}
+                  <span className={`text-xs font-semibold ${s.videoSrc ? 'text-signal-deep' : 'text-mist'}`}>
+                    {s.videoSrc ? 'video' : 'no video yet'}
+                  </span>
+                </button>
+              ))}
+            </div>
+            <p className="mt-2 flex items-start gap-1.5 text-xs text-mist">
+              <Info size={13} className="mt-0.5 shrink-0" />
+              Word matches from the sign catalog. This is not an ISL translation of the sentence.
+            </p>
+          </div>
+        )}
+      </div>
+    </article>
+  );
+}
diff --git a/isl-comp-updated/isl-comp/src/components/daily/Modal.tsx b/isl-comp-updated/isl-comp/src/components/daily/Modal.tsx
