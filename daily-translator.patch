@@ -0,0 +1,130 @@
+import { useMemo, useState } from 'react';
+import { Info, Search, X } from 'lucide-react';
+import {
+  ISL_CATEGORIES,
+  ISL_SIGNS,
+  ISL_VIDEO_COUNT,
+  searchSigns,
+  type IslSign,
+} from '../../data/islSigns';
+import { SignTile } from './SignTile';
+
+interface SignsTabProps {
+  favouriteSigns: string[];
+  onOpen: (sign: IslSign) => void;
+  onUse: (sign: IslSign) => void;
+  onToggleFavourite: (sign: IslSign) => void;
+}
+
+export function SignsTab({ favouriteSigns, onOpen, onUse, onToggleFavourite }: SignsTabProps) {
+  const [query, setQuery] = useState('');
+  const [category, setCategory] = useState<string | null>(null);
+  const [onlyVideo, setOnlyVideo] = useState(false);
+  const [onlyFavourites, setOnlyFavourites] = useState(false);
+
+  const favSet = useMemo(() => new Set(favouriteSigns), [favouriteSigns]);
+  const results = useMemo(
+    () =>
+      searchSigns({
+        query,
+        category,
+        onlyWithVideo: onlyVideo,
+        onlyIds: onlyFavourites ? favSet : null,
+      }),
+    [query, category, onlyVideo, onlyFavourites, favSet]
+  );
+
+  const chip = (active: boolean) =>
+    `min-h-[44px] rounded-full border-2 px-3.5 text-sm font-semibold transition-colors ${
+      active ? 'border-signal bg-signal text-[#06231d]' : 'border-white/15 bg-night-card text-cream hover:border-signal'
+    }`;
+
+  return (
+    <div className="space-y-4">
+      <p className="flex items-start gap-2.5 rounded-md border border-voice/40 bg-voice-soft px-3.5 py-3 text-sm text-cream">
+        <Info size={17} className="mt-0.5 shrink-0 text-voice-deep" />
+        <span>
+          This is the ISL sign catalog ({ISL_SIGNS.length} signs). <strong>Only {ISL_VIDEO_COUNT} have a video in this app so far</strong>;
+          the rest show their name and are marked &ldquo;No video yet&rdquo;. These are single signs, not translations of whole sentences.
+        </span>
+      </p>
+
+      <div>
+        <label htmlFor="sign-search" className="sr-only">
+          Search signs
+        </label>
+        <div className="relative">
+          <Search size={18} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-mist" />
+          <input
+            id="sign-search"
+            type="search"
+            value={query}
+            onChange={(event) => setQuery(event.target.value)}
+            placeholder="Search signs, e.g. doctor"
+            autoComplete="off"
+            className="min-h-[52px] w-full rounded-md border-2 border-white/15 bg-night-card pl-11 pr-12 text-lg text-cream outline-none focus-visible:border-signal"
+          />
+          {query && (
+            <button
+              type="button"
+              onClick={() => setQuery('')}
+              aria-label="Clear search"
+              className="absolute right-1.5 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-sm text-mist hover:text-cream"
+            >
+              <X size={18} />
+            </button>
+          )}
+        </div>
+      </div>
+
+      <div role="group" aria-label="Filter signs" className="flex flex-wrap gap-2">
+        <button type="button" aria-pressed={onlyVideo} onClick={() => setOnlyVideo((v) => !v)} className={chip(onlyVideo)}>
+          Has video ({ISL_VIDEO_COUNT})
+        </button>
+        <button type="button" aria-pressed={onlyFavourites} onClick={() => setOnlyFavourites((v) => !v)} className={chip(onlyFavourites)}>
+          Favourites ({favouriteSigns.length})
+        </button>
+      </div>
+
+      <div role="group" aria-label="Sign categories" className="flex flex-wrap gap-2">
+        <button type="button" aria-pressed={category === null} onClick={() => setCategory(null)} className={chip(category === null)}>
+          All ({ISL_SIGNS.length})
+        </button>
+        {ISL_CATEGORIES.map((c) => (
+          <button
+            key={c.category}
+            type="button"
+            aria-pressed={category === c.category}
+            onClick={() => setCategory(category === c.category ? null : c.category)}
+            className={chip(category === c.category)}
+          >
+            {c.label} ({c.count})
+          </button>
+        ))}
+      </div>
+
+      <p role="status" className="text-sm text-mist">
+        {results.length === 0 ? 'No signs match your filters.' : `${results.length} sign${results.length === 1 ? '' : 's'}`}
+      </p>
+
+      {results.length === 0 ? (
+        <div className="rounded-md border-2 border-dashed border-white/15 px-4 py-8 text-center text-base text-mist">
+          Try a different word, or clear the filters.
+        </div>
+      ) : (
+        <div className="grid grid-cols-1 gap-2.5 min-[420px]:grid-cols-2 xl:grid-cols-3">
+          {results.map((sign) => (
+            <SignTile
+              key={sign.id}
+              sign={sign}
+              favourite={favSet.has(sign.id)}
+              onOpen={() => onOpen(sign)}
+              onUse={() => onUse(sign)}
+              onToggleFavourite={() => onToggleFavourite(sign)}
+            />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/isl-comp-updated/isl-comp/src/components/daily/SuggestionsPanel.tsx b/isl-comp-updated/isl-comp/src/components/daily/SuggestionsPanel.tsx
new file mode 100644
index 0000000..40fd7d1
--- /dev/null
+++ b/isl-comp-updated/isl-comp/src/components/daily/SuggestionsPanel.tsx
@@ -0,0 +1,165 @@
+import { useCallback, useEffect, useRef, useState, type ReactNode } from 'react';
+import { Info, Loader2, Sparkles } from 'lucide-react';
+import type { ScenarioId } from '../../data/dailyScenarios';
+import { getSuggestions } from '../../services/dailySuggestions';
+
+interface SuggestionsPanelProps {
+  scenarioId: ScenarioId;
+  scenarioLabel: string;
+  /** The user's own description (custom situations). */
+  description: string;
+  /** Texts already on screen, so suggestions never repeat them. */
+  existingTexts: string[];
+  /** Recent conversation texts; empty when the user turned context off. */
+  recentTexts: string[];
+  /** null while the status check is still running. */
+  aiAvailable: boolean | null;
+  /** Increment to fetch immediately (used after a custom description is submitted). */
+  autoFetchToken?: number;
+  /** For custom situations, suggestions need a description first. */
+  needsDescription?: boolean;
+  renderCard: (text: string) => ReactNode;
+}
+
+const MAX_ITEMS = 30;
+
+export function SuggestionsPanel({
+  scenarioId,
+  scenarioLabel,
+  description,
+  existingTexts,
+  recentTexts,
+  aiAvailable,
+  autoFetchToken = 0,
+  needsDescription = false,
+  renderCard,
+}: SuggestionsPanelProps) {
+  const [items, setItems] = useState<string[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [notice, setNotice] = useState('');
+  const [source, setSource] = useState<'ai' | 'offline' | null>(null);
+  const [exhausted, setExhausted] = useState(false);
+  const requestRef = useRef(0);
+  const controllerRef = useRef<AbortController | null>(null);
+
+  // Always read the latest props inside the async loader.
+  const latest = useRef({ existingTexts, recentTexts, description, aiAvailable, items });
+  latest.current = { existingTexts, recentTexts, description, aiAvailable, items };
+
+  const load = useCallback(
+    async (fresh = false) => {
+      controllerRef.current?.abort();
+      const controller = new AbortController();
+      controllerRef.current = controller;
+      const id = ++requestRef.current;
+      setLoading(true);
+      setExhausted(false);
+      const current = latest.current;
+      try {
+        const result = await getSuggestions(
+          {
+            scenarioId,
+            scenarioLabel,
+            description: current.description,
+            recent: current.recentTexts,
+            existing: [...current.existingTexts, ...(fresh ? [] : current.items)],
+            count: 8,
+          },
+          { aiAvailable: current.aiAvailable !== false, signal: controller.signal }
+        );
+        if (id !== requestRef.current) return;
+        setItems((prev) => [...(fresh ? [] : prev), ...result.suggestions].slice(0, MAX_ITEMS));
+        setSource(result.source);
+        setNotice(result.notice ?? '');
+        setExhausted(result.suggestions.length === 0);
+      } catch {
+        // Only an aborted (superseded or unmounted) request lands here.
+      } finally {
+        if (id === requestRef.current) setLoading(false);
+      }
+    },
+    [scenarioId, scenarioLabel]
+  );
+
+  useEffect(() => {
+    if (autoFetchToken > 0) void load(true);
+  }, [autoFetchToken, load]);
+
+  useEffect(() => () => controllerRef.current?.abort(), []);
+
+  const disabled = loading || needsDescription;
+
+  return (
+    <section aria-labelledby="more-suggestions-heading" className="space-y-3">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center gap-2">
+          <h3 id="more-suggestions-heading" className="font-display text-lg font-semibold text-cream">
+            More suggestions
+          </h3>
+          {source && (
+            <span
+              className={`inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-semibold ${
+                source === 'ai'
+                  ? 'border-signal/40 bg-signal-soft text-signal-deep'
+                  : 'border-white/15 bg-white/[0.06] text-mist'
+              }`}
+            >
+              {source === 'ai' && <Sparkles size={12} />}
+              {source === 'ai' ? 'AI' : 'Built-in'}
+            </span>
+          )}
+        </div>
+        <button
+          type="button"
+          onClick={() => void load(false)}
+          disabled={disabled}
+          className="btn-primary min-h-[48px] px-5 text-base"
+        >
+          {loading ? <Loader2 size={18} className="animate-spin" /> : <Sparkles size={18} />}
+          {loading ? 'Finding cards…' : items.length === 0 ? 'More suggestions' : 'Show more'}
+        </button>
+      </div>
+
+      {needsDescription && (
+        <p className="text-sm text-mist">Describe your situation above to get suggestions.</p>
+      )}
+
+      {aiAvailable === false && !notice && (
+        <p className="flex items-start gap-2 text-sm text-mist">
+          <Info size={16} className="mt-0.5 shrink-0" />
+          AI suggestions are not set up on this server, so built-in suggestions will be used.
+        </p>
+      )}
+      {aiAvailable !== false && (
+        <p className="flex items-start gap-2 text-sm text-mist">
+          <Info size={16} className="mt-0.5 shrink-0" />
+          AI suggestions send your situation{recentTexts.length > 0 ? ' and recent messages' : ''} to the AI
+          service through this app&rsquo;s server.
+        </p>
+      )}
+
+      {notice && (
+        <p role="status" className="flex items-start gap-2 rounded-sm border border-voice/40 bg-voice-soft px-3 py-2 text-sm text-cream">
+          <Info size={16} className="mt-0.5 shrink-0 text-voice-deep" />
+          {notice}
+        </p>
+      )}
+
+      {loading && items.length === 0 && (
+        <div aria-busy="true" aria-label="Loading suggestions" className="space-y-2">
+          {[0, 1, 2].map((n) => (
+            <div key={n} className="h-16 animate-pulse rounded-md border-2 border-white/15 bg-white/[0.06]" />
+          ))}
+        </div>
+      )}
+
+      {items.length > 0 && <div className="space-y-2">{items.map((text) => <div key={text}>{renderCard(text)}</div>)}</div>}
+
+      {exhausted && !loading && (
+        <p role="status" className="text-sm text-mist">
+          No more new suggestions right now. Try writing your own card.
+        </p>
+      )}
+    </section>
+  );
+}
