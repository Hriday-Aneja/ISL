# URL of the Socket.IO signaling server (see /server). Used only to set up
# the WebRTC connection between the two peers — no audio/video ever passes
# through it. Copy this file to .env.local and adjust if needed.
VITE_SIGNALING_SERVER_URL=http://localhost:4000
# WebSocket endpoint for include-ml/recognition_service.py.
VITE_RECOGNITION_SERVICE_URL=ws://127.0.0.1:8765
