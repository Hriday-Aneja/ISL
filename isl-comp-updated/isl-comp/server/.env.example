# Copy to server/.env (git-ignored) and fill in. Never commit the real file.
#
# Daily Translator "More suggestions" uses Claude through THIS server, so the
# key is never sent to the browser. Leave it empty to run without AI: the app
# then uses its built-in suggestions.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_VERSION=2023-06-01
# AI_TIMEOUT_MS=12000
# AI_RATE_LIMIT_PER_MIN=20
# PORT=4000
