{
  "manifest_version": 3,
  "name": "Samvaad - ISL Connect",
  "version": "0.3.0",
  "description": "Recognize Indian Sign Language with your local Samvaad service and send reviewed text to your meeting chat; turn speech into text and a signing avatar; send ready-made Meeting Cards and read captions.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "action": {
    "default_title": "Samvaad - ISL Connect",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content/vcam-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content/platforms/registry.js",
        "src/content/platforms/meet.js",
        "src/content/vcam.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel/*",
        "src/lib/*",
        "config/*",
        "src/icons/*"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}
